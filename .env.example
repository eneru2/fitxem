# Database
DATABASE_URL=postgres://justclock:justclock@localhost:5432/justclock?sslmode=disable

# API
API_ADDR=:8080
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# TSA (RFC 3161) — use "mock" for local dev
TSA_URL=mock

# Stripe (optional for billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ITSS inspection API key (dev default)
ITSS_API_KEY=dev-itss-key
